# --------Start--------

# 大厅保护
# Lobby protection
scoreboard players set lobbyProtect cbraddon 0

# 自动观战
# Auto spectate
scoreboard players set autoSpectate cbraddon 0

# 游戏中拒绝传送回大厅
# Reject lobby teleport in game
scoreboard players set banTpInGame cbraddon 0

# 通过方块加入队伍
# Join team by block
scoreboard players set joinTeamByBlock cbraddon 0

# 强制加入队伍
# Force join team
scoreboard players set forceJoinTeam cbraddon 0

# 物品功能
# Item function
scoreboard players set itemFunction cbraddon 0

# 玩家效果
# Player effects
scoreboard players set playerEffects cbraddon 0

# 队伍效果
# Team effects
scoreboard players set teamEffects cbraddon 0

# 游戏效果
# Game effects
scoreboard players set gameEffects cbraddon 0

# 物品效果
# Item effects
scoreboard players set itemEffects cbraddon 0

# 所有音效
# All sounds
scoreboard players set allSounds cbraddon 0

# 死斗模式
# DeathMatch mode
scoreboard players set deathMatch cbraddon 0

# 登录物品
# Login item
scoreboard players set loginItem cbraddon 0

# --------return--------

# 正常执行
# Command.SINGLE_SUCCESS
return 1